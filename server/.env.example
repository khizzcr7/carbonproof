# Copy to .env and fill in. All values have working local defaults except the Gemini key.
PORT=4100
RPC_URL=http://127.0.0.1:8545
# Optional: enables full Gemini AI verification of projects before issuance.
# Without it, a transparent local heuristic produces the same response shape.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
